{
  "expo": {
    "name": "SummerCal",
    "slug": "summercal-v2",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "summercal",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FF9500"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.summercal.v2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SummerCal uses your location to show local weather and nearby places. You can disable this anytime.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SummerCal uses your location for weather alerts and place suggestions.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF9500"
      },
      "package": "com.summercal.v2",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF9500"
        }
      ],
      [
        "expo-background-fetch",
        "Background fetch for weather and suggestion updates"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
