<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SummerCal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.summercal.v2</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>summercal</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>2.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SummerCal uses your location to show local weather and nearby places. You can disable this anytime.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SummerCal uses your location for weather alerts and place suggestions.</string>
	<key>NSCameraUsageDescription</key>
	<string>SummerCal uses the camera to capture receipt photos for expense tracking.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SummerCal lets you choose receipt photos from your library for expense tracking.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SummerCal can save generated images to your photo library if you choose.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>SummerCal can show your existing calendar events alongside your plans.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>SummerCal can add events to your calendar if you choose.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
</dict>
</plist>
